# The project URL and publishable key are safe to expose. The current guest
# assessment flow still performs all data access through trusted server code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never expose the secret key with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_replace_me
